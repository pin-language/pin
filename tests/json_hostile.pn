// malformed JSON and query strings must never crash or read out of bounds (run under ASAN in CI)
echo strlen(json_string("", "a")), " ", json_has("", "a"), " ", json_float("", "a"), "\n";
echo strlen(json_string("{", "a")), " ", json_has("{", "a"), " ", json_float("{", "a"), "\n";
echo strlen(json_string("}", "a")), " ", json_has("}", "a"), " ", json_float("}", "a"), "\n";
echo strlen(json_string("{\"", "a")), " ", json_has("{\"", "a"), " ", json_float("{\"", "a"), "\n";
echo strlen(json_string("{\"a", "a")), " ", json_has("{\"a", "a"), " ", json_float("{\"a", "a"), "\n";
echo strlen(json_string("{\"a\"", "a")), " ", json_has("{\"a\"", "a"), " ", json_float("{\"a\"", "a"), "\n";
echo strlen(json_string("{\"a\":", "a")), " ", json_has("{\"a\":", "a"), " ", json_float("{\"a\":", "a"), "\n";
echo strlen(json_string("{\"a\":\"", "a")), " ", json_has("{\"a\":\"", "a"), " ", json_float("{\"a\":\"", "a"), "\n";
echo strlen(json_string("{\"a\":\"\\", "a")), " ", json_has("{\"a\":\"\\", "a"), " ", json_float("{\"a\":\"\\", "a"), "\n";
echo strlen(json_string("{\"a\":\"\\u", "a")), " ", json_has("{\"a\":\"\\u", "a"), " ", json_float("{\"a\":\"\\u", "a"), "\n";
echo strlen(json_string("{\"a\":\"\\u12", "a")), " ", json_has("{\"a\":\"\\u12", "a"), " ", json_float("{\"a\":\"\\u12", "a"), "\n";
echo strlen(json_string("{\"a\":\"\\ud800\"}", "a")), " ", json_has("{\"a\":\"\\ud800\"}", "a"), " ", json_float("{\"a\":\"\\ud800\"}", "a"), "\n";
echo strlen(json_string("{\"a\":\"\\ud800\\u\"}", "a")), " ", json_has("{\"a\":\"\\ud800\\u\"}", "a"), " ", json_float("{\"a\":\"\\ud800\\u\"}", "a"), "\n";
echo strlen(json_string("{\"a\":\"\\ud800\\udc00\"}", "a")), " ", json_has("{\"a\":\"\\ud800\\udc00\"}", "a"), " ", json_float("{\"a\":\"\\ud800\\udc00\"}", "a"), "\n";
echo strlen(json_string("{\"a\":1e999}", "a")), " ", json_has("{\"a\":1e999}", "a"), " ", json_float("{\"a\":1e999}", "a"), "\n";
echo strlen(json_string("{\"a\":-}", "a")), " ", json_has("{\"a\":-}", "a"), " ", json_float("{\"a\":-}", "a"), "\n";
echo strlen(json_string("{\"a\":1111111111111111111}", "a")), " ", json_has("{\"a\":1111111111111111111}", "a"), " ", json_float("{\"a\":1111111111111111111}", "a"), "\n";
echo strlen(json_string("{\"a\":[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[1]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]}", "a")), " ", json_has("{\"a\":[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[1]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]}", "a"), " ", json_float("{\"a\":[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[1]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]}", "a"), "\n";
echo strlen(json_string("{\"a\":{\"b\":", "a")), " ", json_has("{\"a\":{\"b\":", "a"), " ", json_float("{\"a\":{\"b\":", "a"), "\n";
echo strlen(json_string("{\"x\":1,,\"a\":2}", "a")), " ", json_has("{\"x\":1,,\"a\":2}", "a"), " ", json_float("{\"x\":1,,\"a\":2}", "a"), "\n";
echo strlen(json_string("{\"x\" 1}", "a")), " ", json_has("{\"x\" 1}", "a"), " ", json_float("{\"x\" 1}", "a"), "\n";
echo strlen(json_string("{\"a\":tru", "a")), " ", json_has("{\"a\":tru", "a"), " ", json_float("{\"a\":tru", "a"), "\n";
echo strlen(json_string("[{\"a\":1}]", "a")), " ", json_has("[{\"a\":1}]", "a"), " ", json_float("[{\"a\":1}]", "a"), "\n";
echo strlen(json_string("   {\"a\" : \"  sp  \" }  ", "a")), " ", json_has("   {\"a\" : \"  sp  \" }  ", "a"), " ", json_float("   {\"a\" : \"  sp  \" }  ", "a"), "\n";
echo strlen(json_string("{\"a\":\"\"}", "a")), " ", json_has("{\"a\":\"\"}", "a"), " ", json_float("{\"a\":\"\"}", "a"), "\n";
echo "[", query_param("/p?", "a"), "] [", url_path("/p?"), "]\n";
echo "[", query_param("/p?a", "a"), "] [", url_path("/p?a"), "]\n";
echo "[", query_param("/p?a=", "a"), "] [", url_path("/p?a="), "]\n";
echo "[", query_param("/p?=x", "a"), "] [", url_path("/p?=x"), "]\n";
echo "[", query_param("/p?a=%", "a"), "] [", url_path("/p?a=%"), "]\n";
echo "[", query_param("/p?a=%4", "a"), "] [", url_path("/p?a=%4"), "]\n";
echo "[", query_param("/p?a=%zz", "a"), "] [", url_path("/p?a=%zz"), "]\n";
echo "[", query_param("/p?&&&a=1&&", "a"), "] [", url_path("/p?&&&a=1&&"), "]\n";
echo "[", query_param("/p?a=1&a=2", "a"), "] [", url_path("/p?a=1&a=2"), "]\n";
echo "[", query_param("/p?%61=b", "a"), "] [", url_path("/p?%61=b"), "]\n";
