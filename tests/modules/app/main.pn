// A program in several files: main.pn imports prices.pn and util/text.pn (as t).
import prices;
import util/text as t;
import blog/post;                             // blog/post.pn imports util/text: paths start at this folder

function total(list<int> $xs): int {          // same name as prices::total, no clash
    $s = 0;
    foreach ($xs as $x) { $s += $x; }
    return $s * 1000;
}

echo prices::price("tea"), " ", prices::price("pizza"), "\n";
$menu = prices::menu();                        // a list returned across files: the caller owns it
echo t::shout(implode(", ", $menu)), "\n";
echo prices::total(["tea", "cake"]), " ", total([1, 2]), "\n";
echo t::shout(prices::label("cake")), "\n";
echo post::title("from a subfolder"), "\n";

import shop;
import routes/[id] as item;                    // brackets in a path need a name

class Gift {                                   // a class here whose field is a class from shop.pn
    public shop::Item $item;
    public function __construct(public string $to, shop::Item $item) {
        $this->item = copy($item);
    }
}

shop::Basket $b = try json_decode("{\"items\":[{\"name\":\"tea\",\"qty\":2},{\"name\":\"cake\",\"qty\":1}]}");
echo count($b->items), " ", $b->items[1]->name, "\n";
Gift $g = try json_decode("{\"to\":\"Nok\",\"item\":{\"name\":\"tea\",\"qty\":3}}");
echo $g->to, " gets ", $g->item->qty, " ", $g->item->name, "\n";
echo item::title(9), "\n";
echo shop::describe(error(404, "no tea")), "\n";
