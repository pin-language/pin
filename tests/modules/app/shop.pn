// Classes json_decode() builds from another file (design P2): the decoder lives in this module.
export class Item {
    public string $name = "";
    public int $qty = 0;
}

export class Basket {
    public list<Item> $items = [];
}

// The built-in Error type can be named in a module too.
export function describe(Error $e): string { return $e->code . ": " . $e->message; }
