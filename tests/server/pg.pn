// PostgreSQL in a server (design/postgres.md G2, G4). Run when PIN_TEST_POSTGRES holds a database URL. With
// one thread, /slow requests wait for the database at the same time (a query never blocks the thread). /late is
// cut by its deadline while the server is still sleeping. /tx-left and /tx-boom leave a transaction open: the
// next user of the connection must not see it. /boom panics while a result is open. /conns counts this
// server's connections (application_name=pin_test_server in the URL).
function db(): db {
    return db_open(env("DATABASE_URL"));
}

function handle(string $method, string $path, string $body): string {
    $route = url_path($path);
    $db = db();
    if ($method == "POST" && $route == "/items") {
        $r = db_query($db, "INSERT INTO pin_srv (name) VALUES (?) ON CONFLICT (name) DO NOTHING RETURNING id", [json_string($body, "name")]);
        if (!db_next($r)) { http_status(409); return "{\"error\":\"exists\"}"; }
        http_status(201);
        return "{\"id\":" . db_int($r, "id") . "}";
    }
    if ($route == "/slow") {
        db_exec($db, "SELECT pg_sleep(0.4)", []);
        return "{\"slow\":true}";
    }
    if ($route == "/late") {
        request_deadline(100);
        db_exec($db, "SELECT pg_sleep(2)", []);
        return "{\"late\":true}";
    }
    if ($route == "/tx-left") {
        db_exec($db, "BEGIN", []);
        db_exec($db, "INSERT INTO pin_srv (name) VALUES ('left')", []);
        return "{\"ok\":true}";
    }
    if ($route == "/tx-boom") {
        db_exec($db, "BEGIN", []);
        db_exec($db, "INSERT INTO pin_srv (name) VALUES ('boom')", []);
        map<string,int> $m = [];
        return "{\"x\":" . $m["missing"] . "}";
    }
    if ($route == "/leftovers") {
        return db_json($db, "SELECT count(*) AS n FROM pin_srv WHERE name IN ('left', 'boom')", []);
    }
    if ($route == "/boom") {
        $r = db_query($db, "SELECT name FROM pin_srv", []);
        db_next($r);
        map<string,int> $m = [];
        return "{\"x\":" . $m["missing"] . "}";
    }
    if ($route == "/conns") {
        return db_json($db, "SELECT count(*) AS n FROM pg_stat_activity WHERE application_name = 'pin_test_server'", []);
    }
    http_status(404);
    return "{\"error\":\"not found\"}";
}
function setup(): void {                     // in a function: its connection goes back before serve()
    $db = db();
    db_exec($db, "DROP TABLE IF EXISTS pin_srv", []);
    db_exec($db, "CREATE TABLE pin_srv (id bigserial PRIMARY KEY, name text NOT NULL UNIQUE)", []);
}
setup();
db_pool(env("DATABASE_URL"), 4, 60000);
serve(8110, "handle");
