// Request and response headers, and the limits that keep slow or hostile clients from holding the server.
function handle(string $method, string $path, string $body): string throws {
    $route = url_path($path);
    if ($route == "/echo-header") {
        return json_encode(["name" => request_header("x-name"), "has" => request_has_header("X-Name") ? "yes" : "no",
                            "missing" => request_header("X-Missing")]);
    }
    if ($route == "/redirect") {
        http_status(302);
        response_header("Location", "/target");
        response_header("Set-Cookie", "a=1; HttpOnly");
        response_header("Set-Cookie", "b=2");
        return "";
    }
    if ($route == "/html") {
        response_header("Content-Type", "text/html; charset=utf-8");
        return "<p>hi</p>";
    }
    if ($route == "/inject") {                 // the value comes from the client: CR/LF must not get through
        response_header("X-Echo", query_param($path, "v"));
        return "{\"ok\":true}";
    }
    if ($route == "/own") {
        response_header("Content-Length", "1");
        return "{}";
    }
    if ($route == "/fail") {                   // an error after setting a header: the header is not sent
        response_header("Set-Cookie", "should=not-be-sent");
        throw error(403, "no");
    }
    return "{\"ok\":true}";
}

serve(8087, "handle");
