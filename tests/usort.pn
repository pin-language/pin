// usort with a named comparison: objects, strings, floats; stable
class P { public function __construct(public string $name, public int $price) {} }
function by_price(P $a, P $b): int { return $a->price - $b->price; }
function by_name_desc(P $a, P $b): int { return $b->name < $a->name ? -1 : ($b->name > $a->name ? 1 : 0); }
function by_len(string $a, string $b): int { return strlen($a) - strlen($b); }
function desc(float $a, float $b): int { return $a < $b ? 1 : ($a > $b ? -1 : 0); }
list<P> $ps = [new P("tea", 45), new P("cake", 120), new P("rice", 30), new P("milk", 45)];
usort($ps, "by_price");
foreach ($ps as $p) { echo $p->name, " "; }
echo "\n";
usort($ps, "by_name_desc");
echo json_encode($ps), "\n";
list<string> $ws = ["ccc", "a", "bb", "dd"];
usort($ws, "by_len");
echo json_encode($ws), "\n";
list<float> $fs = [1.5, 3.25, -2.0];
usort($fs, "desc");
echo json_encode($fs), "\n";
