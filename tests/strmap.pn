echo str_repeat("ab", 3), "\n";

$m = ["one" => 1, "two" => 2];
$m["three"] = 3;
$m["one"] += 10;
echo count($m), " ", $m["one"], " ", $m["three"], " ", $m["nine"] ?? -1, " ", isset($m["two"]), "\n";
unset($m["two"]);
foreach ($m as $k => $v) { echo $k, "=", $v, ";"; }
echo "\n";
echo json_encode($m), "\n";

$counts = wc("the cat and The dog and the bird");
echo json_encode($counts), "\n";

map<int,string> $names = [];
$names[7] = "seven";
$names[7] .= "!";
$names[1] = "one";
echo json_encode($names), " ", $names[7], "\n";
$copy = copy($names);
$copy[1] = "uno";
echo $names[1], " ", $copy[1], "\n";

