echo substr("hello world", 6), "|", substr("hello", -3), "|", substr("hello", 1, 3), "|", substr("hello", 1, -1), "\n";
echo strpos("hello", "ll"), " ", strpos("hello", "zz"), " ", str_contains("abc", "b"), " ", str_starts_with("/user/7", "/user/"), "\n";
