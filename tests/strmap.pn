function greet(string $name, int $n): string {
    $s = "Hi " . $name . "!";
    for ($i = 0; $i < $n; $i++) { $s .= "!"; }
    return $s;                       // moves the owned string out, no copy
}

function wc(string $text): map<string,int> {
    map<string,int> $counts = [];
    $start = 0;
    $len = strlen($text);
    while ($start < $len) {
        $sp = strpos(substr($text, $start), " ");
        $end = $sp < 0 ? $len : $start + $sp;
        $w = strtolower(substr($text, $start, $end - $start));
        if (strlen($w) > 0) { $counts[$w] += 1; }
        $start = $end + 1;
    }
    return $counts;
}

echo greet("PinaTo", 3), "\n";
$a = "abc";
$b = $a;              // strings copy
$b .= "def";
echo "$a $b {$a}x ", strlen($b), "\n";
echo "cmp: ", ($a == "abc"), " ", ($a < $b), " ", ("x" != "y"), "\n";
