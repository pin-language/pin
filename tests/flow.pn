// The checker follows each branch separately (B3) and only merges where paths meet.
function pick(bool $big): list<int> {
    $a = fill(3, 1);
    $b = fill(2, 2);
    if ($big) {
        $c = $a;                 // $a moved only on this path...
        echo "then ", count($c), " ", count($b), "\n";
        return $c;
    } else {
        echo "else ", count($a), "\n";   // ...so it is still usable here
    }
    return $a;                   // the moving path returned, so $a is fine here too
}

function first_big(list<int> $xs): int {
    $found = -1;
    foreach ($xs as $i => $x) {
        if ($x > 10) { $found = $i; break; }
    }
    return $found;
}

echo count(pick(true)), " ", count(pick(false)), "\n";

$flag = intval("1") == 1;
if ($flag) { $n = 1; } else { $n = 2; }        // assigned on both paths
echo "n=$n\n";

$owner = fill(4, 0);
$keep = fill(1, 0);
while (true) {
    $keep = $owner;              // moved, but the loop never goes round again
    break;
}
echo count($keep), "\n";

$a = fill(2, 0);
if ($flag) { $b = $a; echo count($b), "\n"; }
$a = fill(5, 0);                 // a new value: usable again on every path
echo count($a), "\n";

$total = 0;
for ($i = 0; $i < 10; $i++) {
    if ($i % 2 == 0) { continue; }
    $total += $i;
}
echo $total, " ", first_big([1, 20, 3]), " ", first_big([1, 2]), "\n";
