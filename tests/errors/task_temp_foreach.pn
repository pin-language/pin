function f(int $x): int { sleep_ms(1); return $x; }
function tot(list<int> $xs): int { return count($xs); }
function inc(int &$n): void { $n += 1; }
function mayfail(int $x): int throws { if ($x < 0) { throw error(400, "neg"); } return $x; }
list<Task<int>> $ts = [];
foreach (explode(",", "1,2") as $s) { $ts[] = go tot2($s); }
await_all($ts);
function tot2(string $s): int { return strlen($s); }
