// JSON API: 3 endpoints. Each request runs on one of the server threads;
// there are no global variables, so handlers share nothing and need no locks.

function user(int $id): string {
    list<int> $orders = [];
    $total = 0;
    for ($i = 0; $i < 20; $i++) {
        $amount = ($id * ($i + 7)) % 997;
        $orders[] = $amount;
        $total += $amount;
    }
    return "{\"id\":" . $id
        . ",\"name\":" . json_encode("user" . $id)
        . ",\"email\":" . json_encode("user$id@pinato.co")
        . ",\"orders\":" . json_encode($orders)
        . ",\"total\":" . $total . "}";
}

function primes(int $n): string {
    if ($n < 2 || $n > 1000000) {
        http_status(400);
        return "{\"error\":\"n must be between 2 and 1000000\"}";
    }
    $composite = fill($n + 1, false);
    $count = 0;
    for ($i = 2; $i <= $n; $i++) {
        if (!$composite[$i]) {
            $count++;
            for ($j = $i * $i; $j <= $n; $j += $i) { $composite[$j] = true; }
        }
    }
    return json_encode(["n" => $n, "count" => $count]);
}

function handle(string $method, string $path, string $body): string {
    if ($path == "/hello") {
        return "{\"message\":\"hello world\"}";
    }
    if (str_starts_with($path, "/user/")) {
        return user(intval(substr($path, 6)));
    }
    if (str_starts_with($path, "/primes/")) {
        return primes(intval(substr($path, 8)));
    }
    http_status(404);
    return "{\"error\":\"not found\"}";
}

serve(8081, "handle");
