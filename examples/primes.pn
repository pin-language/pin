<?php
// Sieve of Eratosthenes. Every index is bounds-checked; the compiler (LLVM) removes most checks itself.
function count_primes(int $n): int {
    $composite = fill($n + 1, false);
    $count = 0;
    for ($i = 2; $i <= $n; $i++) {
        if (!$composite[$i]) {
            $count++;
            for ($j = $i * $i; $j <= $n; $j += $i) { $composite[$j] = true; }
        }
    }
    return $count;
}

echo count_primes(100), " primes below 100\n";
echo count_primes(10000000), " primes below 10 million\n";
