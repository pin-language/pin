// A JSON API in one file:  pin examples/api.pn   then, in another terminal:
//   curl localhost:8080/menu
//   curl 'localhost:8080/quote?item=cake&qty=3'
//   curl -X POST -d '{"item":"tea","qty":2}' localhost:8080/orders
// Each request runs on one of the server threads (one per CPU core). There are no global variables,
// so handlers share nothing and need no locks. If a handler panics (missing key, index out of range)
// the client gets a 500 and the server keeps going.
// Prototype server: no TLS, no request headers, no timeouts — do not expose it to the internet.

function prices(): map<string,int> {
    return ["coffee" => 55, "tea" => 40, "cake" => 89];
}

function quote(string $item, int $qty): string {
    $price = prices();
    if (!isset($price[$item])) {
        http_status(404);
        return json_encode(["error" => "no such item"]);
    }
    if ($qty < 1 || $qty > 100) {
        http_status(400);
        return json_encode(["error" => "qty must be 1 to 100"]);
    }
    // a map holds one value type, so mixed JSON objects are built as strings (json_encode quotes text)
    return "{\"item\":" . json_encode($item) . ",\"qty\":" . $qty . ",\"total\":" . ($price[$item] * $qty) . "}";
}

function handle(string $method, string $path, string $body): string {
    $route = url_path($path);                              // drop "?item=..."
    if ($method == "GET" && $route == "/menu") { return json_encode(prices()); }
    if ($method == "GET" && $route == "/quote") {
        return quote(query_param($path, "item"), intval(query_param($path, "qty")));
    }
    if ($method == "POST" && $route == "/orders") {      // body: {"item":"tea","qty":2}
        if (!json_has($body, "item")) {
            http_status(400);
            return json_encode(["error" => "send JSON like {\"item\":\"tea\",\"qty\":2}"]);
        }
        return quote(json_string($body, "item"), json_int($body, "qty"));
    }
    http_status(404);
    return json_encode(["error" => "not found"]);
}

echo "listening on http://localhost:8080 (Ctrl-C to stop)\n";
serve(8080, "handle");
